# Stage 1 needs no keys. Add these in Vercel → Settings → Environment Variables as later stages land.

# Stage 2: Google Places API (New). Server-side only; the browser never sees it.
GOOGLE_PLACES_API_KEY=

# Stage 3: PageSpeed Insights
PAGESPEED_API_KEY=

# Stage 4: ChatGPT recommendation check (OpenAI Responses API + web search)
OPENAI_API_KEY=
# Optional: override the model (default gpt-5-mini)
OPENAI_MODEL=

# Stage 5: leads and email (see README → Leads and email setup)
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Must be on a domain verified in Resend to email prospects
RESEND_FROM=
LEAD_NOTIFY_EMAIL=
# Optional: public address for links in emails
SITE_URL=

# Attio CRM: Workspace settings → Developers → Access tokens.
# Scopes: record_permission read-write, object_configuration read, note read-write,
# list_entry read-write, list_configuration read.
ATTIO_API_KEY=
# Optional: the list's API slug (Attio → list → Settings), e.g. practice_grader_leads
ATTIO_LIST=

# Stage 6: bot protection (Cloudflare Turnstile). Both needed; redeploy after setting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional scan limits (defaults shown)
SCAN_LIMIT_HOUR=5
SCAN_LIMIT_DAY=15
SCAN_LIMIT_GLOBAL_DAY=300
SCAN_REUSE_HOURS=24
# Optional: salt for hashing visitor IPs (defaults to a value derived from the Supabase key)
IP_HASH_SALT=
# Footer and privacy page contact details
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Google Analytics 4: defaults to G-FM4HLLK9HV. Set to another G- ID to change it, or "off" to disable.
NEXT_PUBLIC_GA_ID=
